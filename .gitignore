# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Ignore CSV files globally
*.csv
*.csv.gz

# Ignore everything inside data by default
data/**

# Allow access to data subdirectories
!data/
!data/**/

# Allow CSV files inside data
!data/**/*.csv
!data/**/*.csv.gz
# Allow Excel files inside data/
!data/**/*.xlsx
!data/**/*.xls

# Temporary files
*.tmp
*.log
*.temp

# IDE and editor files
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini