# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# MIMIC-IV and other raw data
*.csv
*.csv.gz

# Project data: ignore everything by default
data/**

# Allow Git to access data subdirectories
!data/
!data/**/

# Allow Excel files inside data/
!data/**/*.xlsx
!data/**/*.xls

# Temporary files
*.tmp
*.log
*.temp

# IDE and editor files
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini